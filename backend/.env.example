# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bastet_temple
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bastet_temple_test

# JWT / Security Settings
SECRET_KEY=replace-with-a-secure-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS / Frontend Settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# Mode & Verification Settings
ENVIRONMENT=development
DEV_EMAIL_MODE=true

# SMTP Email Configuration (optional if DEV_EMAIL_MODE=true)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@bastet-temple.org

# Seeding Settings
# Admin seed. ADMIN_PASSWORD is required — `python -m app.seed` will not create
# the admin without it. Must satisfy the password policy: at least 15 characters,
# not a common password, and not built from the project name.
ADMIN_EMAIL=admin@bastet-temple.org
ADMIN_FULL_NAME=System Admin
ADMIN_PASSWORD=
